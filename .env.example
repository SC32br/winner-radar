# Радар заказов (Winner Radar)
# Скопировать в .env и подставить свои значения. В git не класть .env.

# Имя хоста, как его видит браузер. Для локалки хватит localhost.
SITE_HOST=localhost

# Полный URL дашборда (cookie и редиректы).
SITE_PUBLIC_URL=http://127.0.0.1:8000

# На каком адресе слушает uvicorn внутри машины.
APP_BIND=127.0.0.1

# Порт приложения.
APP_PORT=8000

# Логин входа в дашборд.
DASHBOARD_LOGIN=admin

# Пароль входа. Смените перед любой сетью кроме своей машины.
DASHBOARD_PASSWORD=

# Секрет подписи cookie сессии. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=

# Имя cookie после входа.
SESSION_COOKIE_NAME=radar_session

# Сколько часов держать сессию.
SESSION_HOURS=12

# Cookie только по HTTPS. Для локального http оставьте false.
SESSION_HTTPS_ONLY=false

# Какие Host принимать.
TRUSTED_HOSTS=localhost,127.0.0.1

# Каталог данных: SQLite, логи сбора, документы лотов.
DATA_DIR=./data

# HTTP-прокси к zakupki.gov.ru, если с вашей сети ЕИС не открывается.
# EIS_PROXY=

# DaData: реквизиты юрлица (ИНН, ОГРН, директор, статус, адрес, ОКВЭД).
# На дешёвом тарифе телефонов нет. Лимит около 1000/день.
DADATA_API_KEY=
DADATA_SECRET_KEY=

# Checko: сайт и телефоны по ИНН. Бесплатно около 100 запросов в день.
CHECKO_API_KEY=

# LLM для разбора смет (необязательно). Ключ с https://kie.ai
# LLM_API_KEY=
# LLM_BASE_URL=https://api.kie.ai/gemini-3-6-flash-openai/v1
# LLM_MODEL=gemini-3-6-flash
# LLM_FALLBACK_BASE_URL=https://api.kie.ai/gemini-2.5-flash/v1
# LLM_FALLBACK_MODEL=gemini-2.5-flash
